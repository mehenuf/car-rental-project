# Copy to .env.local and fill in. Never commit real values. See README.md "Environment variables" for what each one does.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, used in emails and to verify webhooks (for example https://your-site.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Security secrets (set long random values in production)
CRON_SECRET=
QUOTE_SIGNING_SECRET=
CONSENT_SALT=
# Set to true once staff have enrolled an authenticator app
ADMIN_REQUIRE_MFA=
# Set to true to require the emailed confirmation link before a new account can sign in
AUTH_REQUIRE_EMAIL_VERIFICATION=

# AI chat assistant (optional: the chat falls back to database-driven answers without them)
GROQ_API_KEY=
GEMINI_API_KEY=

# Email and SMS (optional: without them messages are logged, not sent)
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# Web push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Card payments (optional, Stripe TEST mode only: without them every method is simulated)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Automation and monitoring (optional). N8N_WEBHOOK_URL receives booking and lead events with customer contact details.
N8N_WEBHOOK_URL=
SENTRY_DSN=

# SQL tests only: a scratch local PostgreSQL 16 (the runner drops the public schema)
TEST_DATABASE_URL=
