/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.vscode/
.idea/
*.local

# AI agent files (auto-generated locally, not for the repo)
AGENTS.md
CLAUDE.md
.claude/

# reference
/reference/

# private working notes — session handoff summaries, not for the public repo
PROJECT_CONTEXT.md

# local scratch file for manually testing /api/chat
chat-test.json

# Supabase local CLI state (can hold local service-role/DB keys)
.supabase/
supabase/.temp/

# local databases / dumps
*.sqlite
*.sqlite3
*.db
*.dump

# impeccable design-skill working files — local product/design notes, not for the public repo
PRODUCT.md
DESIGN.md
.impeccable/
